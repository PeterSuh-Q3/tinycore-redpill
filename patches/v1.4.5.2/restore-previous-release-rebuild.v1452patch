   if [ $? -ne 0 ] || [ ! -s "${TMP_ZIP}" ]; then
     echo "[!] Download failed or file is empty: ${URL}"
@@ -570,12 +593,35 @@ function extract_old_shell() {
     return 1
   fi
 
+  for f in "${FILES[@]}"; do
