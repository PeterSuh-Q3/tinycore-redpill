#include <windows.h>

1 24 "cli.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "pRT"
            VALUE "FileDescription", "SynoXtract CLI - Synology .pat/.spk extractor"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "synoxtract"
            VALUE "OriginalFilename", "synoxtract.exe"
            VALUE "ProductName", "SynoXtract"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
