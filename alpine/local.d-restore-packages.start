#!/bin/sh
# Alpine diskless startup hook, installed as /etc/local.d/restore-packages.start.
AUTOLOGIN_HELPER="${MSHELL_AUTOLOGIN_HELPER:-/usr/local/sbin/mshell-autologin-tc}"
AUTOLOGIN_BACKUP="${MSHELL_AUTOLOGIN_BACKUP:-/etc/mshell/mshell-autologin-tc}"
INITTAB_FILE="${MSHELL_INITTAB_FILE:-/etc/inittab}"

autologin_helper_is_valid() {
  local helper="${1}" owner
  [ -f "${helper}" ] && [ ! -L "${helper}" ] && [ -r "${helper}" ] && [ -x "${helper}" ] || return 1
  [ "$(head -n 1 "${helper}" 2>/dev/null)" = '#!/bin/sh' ] || return 1
  [ "$(grep -Fxc 'exec /bin/login -f tc' "${helper}" 2>/dev/null)" -eq 1 ] || return 1
  /bin/sh -n "${helper}" >/dev/null 2>&1 || return 1
  owner="$(stat -c '%u:%g' "${helper}" 2>/dev/null)" || return 1
  [ "${owner}" = '0:0' ]
}

repair_tty1_autologin() {
  local staged="${AUTOLOGIN_HELPER}.repair.$$"

  if ! autologin_helper_is_valid "${AUTOLOGIN_HELPER}"; then
    echo "MSHELL: tty1 autologin helper is missing or invalid; attempting backup restore." >&2
    if autologin_helper_is_valid "${AUTOLOGIN_BACKUP}" && \
       cp "${AUTOLOGIN_BACKUP}" "${staged}" && \
       chown root:root "${staged}" && chmod 0755 "${staged}" && \
       mv -f "${staged}" "${AUTOLOGIN_HELPER}" && \
       autologin_helper_is_valid "${AUTOLOGIN_HELPER}"; then
      echo "MSHELL: tty1 autologin helper restored from ${AUTOLOGIN_BACKUP}."
    else
      rm -f "${staged}"
      echo "MSHELL: helper recovery failed; switching tty1 to a normal login prompt." >&2
      # OpenRC's default runlevel is a blocking ::wait action in inittab, so
      # this runs before init starts tty1's respawning getty.
      if grep -q '^tty1::respawn:' "${INITTAB_FILE}"; then
        sed -i 's|^tty1::respawn:.*|tty1::respawn:/sbin/getty 38400 tty1|' "${INITTAB_FILE}"
      fi
      return 1
    fi
  fi

  return 0
}

if [ "${MSHELL_AUTOLOGIN_TEST_ONLY:-0}" = 1 ]; then
  repair_tty1_autologin
  exit $?
fi

mount -o remount,size=90% / 2>/dev/null || true

# The tty1 getty starts only after the blocking OpenRC default-runlevel wait
# below has completed. Repair its executable here before getty tries to exec it.
repair_tty1_autologin || true

/usr/local/sbin/rebuildnetifaces
/usr/local/sbin/rebuildfstab
/usr/local/sbin/setup-disk-swap

# The RTC on unattended appliances can be years behind.  Refresh it before
# the first HTTPS operation: apk repositories and GitHub reject certificates
# outside their validity period.  BusyBox ntpd is available from alpine-base,
# so this does not depend on a package that has not been restored yet.
# Keep the local console usable when the network is absent, but never run the
# package restore with an invalid clock after a reachable network was found.
sync_clock_before_https() {
  local server year
  for server in time.cloudflare.com time.google.com pool.ntp.org; do
    timeout 15 busybox ntpd -n -q -p "${server}" >/tmp/mshell-ntp.log 2>&1 || true
    year="$(date +%Y 2>/dev/null || echo 0)"
    [ "${year}" -ge 2024 ] && return 0
  done
  return 1
}

ALP_DEV="$(blkid -L alpine 2>/dev/null)"
if [ -n "${ALP_DEV}" ]; then
  SRC_MNT="$(mount | awk -v d="${ALP_DEV}" '$1 == d { print $3; exit }')"
  if [ -z "${SRC_MNT}" ]; then
    mkdir -p /media/alpine
    mount "${ALP_DEV}" /media/alpine 2>/dev/null || true
    SRC_MNT="$(mount | awk -v d="${ALP_DEV}" '$1 == d { print $3; exit }')"
  fi
  if [ -n "${SRC_MNT}" ]; then
    mount -o remount,rw "${SRC_MNT}" 2>/dev/null || true
    mkdir -p /mnt/alpine
    mountpoint -q /mnt/alpine || mount "${ALP_DEV}" /mnt/alpine
  fi
fi

[ -f /etc/apk/world ] || exit 0
if ! sync_clock_before_https; then
  echo "MSHELL: system clock synchronization failed; skipping HTTPS package restore." >&2
  exit 0
fi
apk add --update $(cat /etc/apk/world) > /tmp/pkg-restore.log 2>&1

# A disk-specific NVRAM entry avoids firmware selecting a co-installed
# TinyCore fallback loader. It is only created after the dedicated EFI file
# in the release image has been verified.
if [ -d /sys/firmware/efi/efivars ] && apk add --no-cache efibootmgr >> /tmp/pkg-restore.log 2>&1; then
  loader_disk="/dev/$(lsblk -no PKNAME "${ALP_DEV}" 2>/dev/null | head -n 1)"
  case "${loader_disk##*/}" in
    *[0-9]) efi_part="${loader_disk}p1" ;;
    *) efi_part="${loader_disk}1" ;;
  esac

  efi_mount="$(mount | awk -v d="${efi_part}" '$1 == d { print $3; exit }')"
  mounted_efi="false"
  if [ -z "${efi_mount}" ] && [ -b "${efi_part}" ]; then
    efi_mount="/run/alpine-redpill-efi"
    mkdir -p "${efi_mount}"
    if mount -o ro "${efi_part}" "${efi_mount}"; then
      mounted_efi="true"
    else
      efi_mount=""
    fi
  fi

  if [ -n "${efi_mount}" ] && [ -f "${efi_mount}/EFI/AlpineRedpill/grubx64.efi" ]; then
    if ! efibootmgr | grep -q 'Alpine Redpill$'; then
      efibootmgr -c -d "${loader_disk}" -p 1 \
        -L 'Alpine Redpill' \
        -l '\EFI\AlpineRedpill\grubx64.efi' >> /tmp/efibootmgr.log 2>&1
    fi

    alpine_bootnum="$(efibootmgr | awk '/Alpine Redpill$/ { entry = $1; sub(/^Boot/, "", entry); sub(/\*$/, "", entry); print entry; exit }')"
    current_order="$(efibootmgr | sed -n 's/^BootOrder:[[:space:]]*//p')"
    if [ -n "${alpine_bootnum}" ] && [ -n "${current_order}" ]; then
      remaining_order="$(echo "${current_order}" | tr ',' '\n' | grep -v "^${alpine_bootnum}$" | paste -sd, -)"
      efibootmgr -o "${alpine_bootnum}${remaining_order:+,${remaining_order}}" >> /tmp/efibootmgr.log 2>&1
    fi
  fi

  [ "${mounted_efi}" = "true" ] && umount "${efi_mount}"
fi

sudo /usr/bin/ttyd -W login -f tc 2>/dev/null &
