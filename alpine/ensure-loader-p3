#!/bin/sh
# Prepare the loader's VFAT P3 before swap and before tc processes start.
# Also called by functions.sh/functions_t.sh after boot.
set -u

dev=$(blkid -t UUID=6234-C863 -o device 2>/dev/null | head -n 1)
[ -n "$dev" ] && [ -b "$dev" ] || { echo '[P3] loader partition not found' >&2; exit 1; }
dev=$(readlink -f "$dev") || exit 1
[ "$(blockdev --getro "$dev" 2>/dev/null)" = 0 ] || {
    echo "[P3] block device is read-only: $dev" >&2
    exit 1
}
point="/mnt/${dev##*/}"
mm=$(cat "/sys/class/block/${dev##*/}/dev" 2>/dev/null)
[ -n "$mm" ] || exit 1

mkdir -p /run /mnt "$point"
exec 9>/run/mshell-p3-mount.lock
flock -x 9 || exit 1

mounts() { awk -v mm="$mm" '$3 == mm { print $5 }' /proc/self/mountinfo; }
mount_options() {
    awk -v mm="$mm" -v p="$point" '$3 == mm && $5 == p { opts=$6 "," $NF } END { print opts }' /proc/self/mountinfo
}
count=$(mounts | wc -l | tr -d ' ')
if [ "$count" -eq 1 ] && [ "$(mounts)" = "$point" ]; then
    opts=$(mount_options)
    case ",$opts," in *,rw,*) rw=yes ;; *) rw=no ;; esac
    case ",$opts," in *,fmask=0000,*) fm=yes ;; *) fm=no ;; esac
    case ",$opts," in *,dmask=0000,*) dm=yes ;; *) dm=no ;; esac
    if [ "$rw:$fm:$dm" = yes:yes:yes ] && [ -w "$point" ] &&
       { [ ! -f "$point/user_config.json" ] || [ -w "$point/user_config.json" ]; }; then
        exit 0
    fi
fi

# Never disturb a swapfile or an unexpected mount location.
if awk -v p="$point/" -v q="/media/${dev##*/}/" 'NR > 1 && (index($1,p)==1 || index($1,q)==1) {found=1} END {exit !found}' /proc/swaps; then
    echo '[P3] active swap prevents remount' >&2
    exit 1
fi
for path in $(mounts); do
    case "$path" in "$point"|"/media/${dev##*/}") ;; *) echo "[P3] unexpected mount: $path" >&2; exit 1 ;; esac
done

# umount removes only the top layer. Drain every P3 mount, including the
# initramfs read-only /media mount, before creating one canonical mount.
attempt=0
while [ "$(mounts | wc -l | tr -d ' ')" -gt 0 ]; do
    attempt=$((attempt + 1))
    [ "$attempt" -le 8 ] || { echo '[P3] too many mount layers' >&2; exit 1; }
    path=$(mounts | tail -n 1)
    umount "$path" || { echo "[P3] busy mount: $path" >&2; exit 1; }
done

if ! mount -t vfat -o rw,umask=000 "$dev" "$point"; then
    echo '[P3] writable mount failed; leaving P3 read-only for inspection' >&2
    mount -t vfat -o ro "$dev" "$point" 2>/dev/null || true
    exit 1
fi
opts=$(mount_options)
case ",$opts," in *,rw,*) ;; *) exit 1 ;; esac
case ",$opts," in *,fmask=0000,*) ;; *) exit 1 ;; esac
case ",$opts," in *,dmask=0000,*) ;; *) exit 1 ;; esac
[ -w "$point" ] || exit 1
[ ! -f "$point/user_config.json" ] || [ -w "$point/user_config.json" ] || exit 1
echo "[P3] mounted $dev at $point with writable tc permissions"
